{
  // 이 파일은 전체 모노레포에서 사용될 기본 TypeScript 설정입니다.
  // 각 하위 프로젝트(패키지)는 이 설정을 상속받아 확장할 수 있습니다.
  "compilerOptions": {
    "target": "ESNext", // 최신 ECMAScript 기능 사용
    "module": "ESNext", // 모듈 시스템으로 ESNext 사용
    "moduleResolution": "node", // 모듈 해석 방식으로 node 사용
    "resolveJsonModule": true, // .json 파일 import 허용
    "isolatedModules": true, // 각 파일을 별도의 모듈로 처리 (Vite, Babel 등에서 필요)
    "noEmit": true, // 컴파일된 출력 파일(예: .js)을 생성하지 않음 (주로 타입 체크만 할 때 사용)
    "jsx": "react-jsx", // JSX를 React 17+의 새로운 방식으로 변환
    "strict": true, // 모든 엄격한 타입-체킹 옵션 활성화
    "esModuleInterop": true, // CommonJS 모듈을 ES6 모듈처럼 가져올 수 있게 함
    "skipLibCheck": true, // 라이브러리 파일(.d.ts)의 타입 체크를 건너뜀
    "forceConsistentCasingInFileNames": true, // 파일 이름의 대소문자를 일관되게 사용하도록 강제
    "allowImportingTsExtensions": true,
    // 사용되지 않는 지역 변수 체크
    "noUnusedLocals": false,
    // 사용되지 않는 매개변수 체크
    "noUnusedParameters": false
  }
}
